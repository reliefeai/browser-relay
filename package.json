{
  "name": "@linsoai/browser-relay",
  "version": "1.4.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Agent-native browser control through a Skill + CLI: share your existing, logged-in Chrome locally or across multiple machines.",
  "homepage": "https://github.com/reliefeai/browser-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reliefeai/browser-relay.git"
  },
  "main": "server/relay-server.js",
  "bin": {
    "browser-relay": "server/cli.js",
    "browser-relay-mcp": "server/mcp-server.js",
    "browser-relay-hub": "server/hub-server.js"
  },
  "files": [
    "server/",
    "extension/",
    "hub/",
    "docs/remote-control-hub.md",
    "docs/demo/intranet.html",
    "skills/",
    "README.md",
    "docs/README.zh-CN.md"
  ],
  "scripts": {
    "start": "node server/relay-server.js",
    "hub": "node server/hub-server.js",
    "hub:dry-run": "wrangler deploy --config hub/wrangler.toml --dry-run",
    "hub:deploy": "wrangler deploy --config hub/wrangler.toml",
    "mcp": "node server/mcp-server.js",
    "test": "node --test",
    "pack:dry-run": "npm pack --dry-run",
    "sync-version": "node scripts/sync-version.mjs",
    "prepublishOnly": "node scripts/sync-version.mjs",
    "postinstall": "node server/install.js",
    "postuninstall": "node server/uninstall.js"
  },
  "keywords": [
    "agent-skill",
    "agent-browser",
    "browser-agent",
    "browser-control",
    "browser-cli",
    "browser-skill",
    "browser",
    "automation",
    "cli",
    "cdp",
    "ai-agent",
    "chrome",
    "logged-in-browser",
    "remote-browser"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
